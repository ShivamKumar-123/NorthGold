# ─── Copy to .env and fill in before starting ────────────────────────────────
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api,yourdomain.com,admin.yourdomain.com
LOG_LEVEL=INFO

# Database — POSTGRES_PASSWORD must match the password inside DATABASE_URL
POSTGRES_DB=findb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://postgres:CHANGE_ME_strong_db_password@postgres:5432/findb

# Redis — backs Celery, the channel layer for live prices, and the cache
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS / CSRF — the origins the two front-ends are served from
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Live price ticker cadence, in seconds
PRICE_TICK_SECONDS=5

# ─── Front-end build args ────────────────────────────────────────────────────
# Inlined into the JS bundle at BUILD time, so they must be the URLs a BROWSER
# can reach — not internal Docker service names.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

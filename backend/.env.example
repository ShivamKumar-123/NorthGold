# Local development without Docker. Copy to backend/.env
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is fine for a quick local run; the recursive-CTE downline query and
# every test work on both backends. Use PostgreSQL for anything real.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://postgres:password@localhost:5432/findb

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
PRICE_TICK_SECONDS=5
LOG_LEVEL=INFO
